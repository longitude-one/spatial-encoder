{
    "name": "longitude-one/spatial-encoder",
    "type": "library",
    "description": "This library encode any spatial interfaces into different binary or string format.",
    "keywords": ["encode", "opengis", "postgis", "gis", "spatial", "geometry", "geography", "iso-13249", "ewkb", "wkt", "ewkt", "wkd", "php"],
    "authors": [
        {
            "name": "Alexandre Tranchant",
            "email": "alexandre.tranchant@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "longitude-one/spatial-types": "1.0.0-RC.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "jetbrains/phpstorm-attributes": "^1.1"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "LongitudeOne\\SpatialEncoder\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LongitudeOne\\SpatialEncoder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "quality": [
            "quality/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=quality/php-cs-fixer/.php-cs-fixer.php --allow-risky=yes",
            "quality/php-stan/vendor/bin/phpstan analyse --configuration=quality/php-stan/php-stan.neon lib tests --error-format=table --no-progress --no-interaction --no-ansi --level=9 --memory-limit=256M",
            "quality/php-mess-detector/vendor/bin/phpmd analyze lib --format text --ruleset quality/php-mess-detector/ruleset.yml",
            "quality/php-mess-detector/vendor/bin/phpmd analyze tests --format text --ruleset quality/php-mess-detector/test-ruleset.yml",
            "quality/php-code-sniffer/vendor/bin/phpcs --standard=quality/php-code-sniffer/phpcs.xml -s"
        ],
        "test": "phpunit",
        "test-local": [
            "@test",
            "cat .phpunit-cache/coverage-results.txt"
        ],
        "install-quality-tools": [
            "composer install --working-dir=quality/php-cs-fixer",
            "composer install --working-dir=quality/php-stan",
            "composer install --working-dir=quality/php-mess-detector",
            "composer install --working-dir=quality/php-code-sniffer"
        ],
        "upgrade-quality-tools": [
            "composer update",
            "composer update --working-dir=quality/php-cs-fixer",
            "composer update --working-dir=quality/php-stan",
            "composer update --working-dir=quality/php-mess-detector",
            "composer update --working-dir=quality/php-code-sniffer"
        ]
    }
}
